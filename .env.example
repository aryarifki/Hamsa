# ── Core ─────────────────────────────────────────────────────────────────────
# Public origin used for links and cookie decisions. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32+ byte secret used to encrypt provider credentials and CCTV passwords at rest.
# Generate with: openssl rand -base64 48
HAMSA_SECRET=change-me-please-generate-a-real-secret

# SQLite database file (defaults to ./data/hamsa.db)
HAMSA_DB_PATH=./data/hamsa.db

# Bootstrap admin account created on first boot (only if it does not exist).
HAMSA_ADMIN_EMAIL=admin@hamsa.local
HAMSA_ADMIN_PASSWORD=change-this-on-first-login

# ── Token economics ──────────────────────────────────────────────────────────
# Credits granted to every new account.
HAMSA_SIGNUP_CREDITS=25
# Cost per module lookup, in credits.
HAMSA_COST_PHONE=2
HAMSA_COST_IP=2
HAMSA_COST_EMAIL=3
HAMSA_COST_USERNAME=3
HAMSA_COST_TELEGRAM=4

# ── Optional intelligence providers ──────────────────────────────────────────
# Every provider is optional: Hamsa degrades to offline/public data without them.
IPINFO_TOKEN=
IPAPI_KEY=
ABSTRACT_API_KEY=
NUMVERIFY_KEY=
HUNTER_API_KEY=
HIBP_API_KEY=
SHODAN_API_KEY=

# ── Ops ──────────────────────────────────────────────────────────────────────
# Requests per minute per IP for the public auth endpoints.
HAMSA_AUTH_RATE_LIMIT=10
# Set to "true" to require HTTPS cookies (enable in production).
HAMSA_SECURE_COOKIES=false

# Secret required by POST /api/v1/cron/watchlist. Generate with `openssl rand -hex 24`.
CRON_SECRET=

# Set to "false" to forbid keyless IP lookups (forces a provider key or offline-only).
HAMSA_ALLOW_FREE_PROVIDERS=true
