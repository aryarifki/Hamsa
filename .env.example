# ── Core ─────────────────────────────────────────────────────────────────────
# Public origin used for links and cookie decisions. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32+ byte secret used to encrypt provider credentials and camera passwords at rest.
# Generate with: openssl rand -base64 48
HAMSA_SECRET=change-me-please-generate-a-real-secret

# PostgreSQL connection string. Hamsa requires PostgreSQL 15+.
DATABASE_URL=postgres://hamsa:change-me@127.0.0.1:5432/hamsa
# Maximum connections held by the app process (default 10).
HAMSA_PG_POOL=10

# Separate database used by `npm test` (schema is created and truncated).
# Never point this at production.
TEST_DATABASE_URL=postgres://hamsa:change-me@127.0.0.1:5432/hamsa_test

# Bootstrap admin account created on first boot (only if it does not exist).
HAMSA_ADMIN_EMAIL=admin@hamsa.local
HAMSA_ADMIN_PASSWORD=change-this-on-first-login

# ── Token economics ──────────────────────────────────────────────────────────
# Credits granted to every new account.
HAMSA_SIGNUP_CREDITS=25
# Cost per module lookup, in credits. Defaults: phone 2, ip 2, email 3,
# username 3, telegram 4, hlr 4, whatsapp 4, getcontact 4, ewallet 4, breach 4,
# humint 8, public-evidence 4, name 4, domain 4, telegram-analytics 8.
HAMSA_COST_PHONE=2
HAMSA_COST_IP=2
HAMSA_COST_EMAIL=3
HAMSA_COST_USERNAME=3
HAMSA_COST_TELEGRAM=4
HAMSA_COST_HLR=4
HAMSA_COST_WHATSAPP=4
HAMSA_COST_GETCONTACT=4
HAMSA_COST_EWALLET=4
HAMSA_COST_BREACH=4
HAMSA_COST_HUMINT=8
HAMSA_COST_PUBLIC_EVIDENCE=4
HAMSA_COST_NAME=4
HAMSA_COST_DOMAIN=4
HAMSA_COST_TELEGRAM_ANALYTICS=8

# ── Phone OTP sign-in ────────────────────────────────────────────────────────
# Delivery webhook. Hamsa POSTs {phone, code, channel, expiresAt} to this URL
# with `Authorization: Bearer $OTP_WEBHOOK_TOKEN`. Point it at your SMS/WhatsApp
# gateway adapter; without it (and without dev mode) OTP requests return 503.
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TOKEN=
# Explicit development escape hatch: the code comes back in the API response as
# `devCode`. Never enable this on a reachable deployment.
OTP_DEV_MODE=false
# Cloudflare Turnstile secret for the OTP endpoints. Empty disables the check.
HAMSA_TURNSTILE_SECRET=
# Beta gate surfaced on the landing page and /api/v1/auth/web/beta-status.
HAMSA_BETA_ENABLED=false
# Self-service registration, plus a hard cap on new accounts per 24h (0 = no cap).
HAMSA_REGISTRATION_ENABLED=true
HAMSA_REGISTRATION_LIMIT=0

# ── Top-ups (QRIS / USDT) ────────────────────────────────────────────────────
# Static EMVCo payload from your PJSP. Hamsa appends tag 54 (amount) and
# 62-05 (reference) and recomputes the CRC16. Leave empty to sell nothing until
# the rail is configured (the API then explains what is missing).
HAMSA_QRIS_MERCHANT_PAYLOAD=
# USDT deposit address, and the network name shown to the payer.
HAMSA_USDT_ADDRESS=
HAMSA_USDT_NETWORK=TRC20
# HMAC-SHA256 secret for POST /api/v1/topup/webhook. The signature header is
# `x-hamsa-signature` (hex, optional `sha256=` prefix) over the raw body.
# Generate with `openssl rand -hex 32`. Empty disables the webhook.
HAMSA_TOPUP_WEBHOOK_SECRET=

# ── Public CCTV streams ──────────────────────────────────────────────────────
# The catalogue ships 31 cities with portal links only. To play a city's feed,
# set its env var to one or more comma-separated HLS / MJPEG / JPEG URLs:
#   HAMSA_PUBLIC_CCTV_BANDUNG=https://...,https://...
# Slug is the city id upper-cased with dashes turned into underscores.
# Unset cities report `unavailable` plus a warning instead of inventing a stream.
HAMSA_PUBLIC_CCTV_BANDUNG=
HAMSA_PUBLIC_CCTV_SURABAYA=
HAMSA_PUBLIC_CCTV_DEPOK=
HAMSA_PUBLIC_CCTV_BOGOR=
HAMSA_PUBLIC_CCTV_SEMARANG=
HAMSA_PUBLIC_CCTV_TANGERANG=
HAMSA_PUBLIC_CCTV_BALI=
HAMSA_PUBLIC_CCTV_METRO=
HAMSA_PUBLIC_CCTV_BINAMARGA_TOL=
HAMSA_PUBLIC_CCTV_BINAMARGA_NONTOL=

# ── Optional intelligence providers ──────────────────────────────────────────
# Every provider is optional: Hamsa degrades to offline/public data without them,
# and each module states in its response which sources answered.
IPINFO_TOKEN=
IPAPI_KEY=
ABSTRACT_API_KEY=
NUMVERIFY_KEY=
HUNTER_API_KEY=
HIBP_API_KEY=
LEAKCHECK_API_KEY=
SHODAN_API_KEY=
# GetContact / e-wallet aggregator endpoints (base URL + bearer key).
GETCONTACT_API_URL=
GETCONTACT_API_KEY=
EWALLET_API_URL=
EWALLET_API_KEY=
# NASA FIRMS map key for active-fire hotspots in Polaris-X.
FIRMS_MAP_KEY=
# Directory of HUMINT records (.json/.jsonl) ingested by the humint module.
HAMSA_HUMINT_DIR=./data/humint

# ── Cameras (own assets) ─────────────────────────────────────────────────────
# Private snapshot directory. Must not be inside public/ and must not be served
# by the reverse proxy. Defaults to ./storage.
HAMSA_STORAGE_DIR=./storage
# Snapshot/ffmpeg binary (default `ffmpeg` from PATH).
HAMSA_FFMPEG_PATH=ffmpeg
# Allow file:// and local paths as camera input. Off by default in production;
# useful for the README demo on a laptop. Never enable on a shared deployment.
HAMSA_CCTV_ALLOW_LOCAL_MEDIA=false
# Foreground ratio that counts as motion when a camera has no per-camera value.
HAMSA_MOTION_THRESHOLD=0.01
# Delete snapshot metadata + files older than this many days.
HAMSA_SNAPSHOT_RETENTION_DAYS=14
# Cameras handled per cron pass.
HAMSA_CAMERA_BATCH=5

# ── Ops ──────────────────────────────────────────────────────────────────────
# Requests per minute per IP for the public auth endpoints.
HAMSA_AUTH_RATE_LIMIT=10
# Trust CF-Connecting-IP/X-Real-IP/X-Forwarded-For only when behind a trusted proxy.
HAMSA_TRUST_PROXY=false
# Set to "true" to require HTTPS cookies (enable in production).
HAMSA_SECURE_COOKIES=false

# Secret required by POST /api/v1/cron/watchlist and /api/v1/cron/cameras.
# Generate with `openssl rand -hex 24`.
CRON_SECRET=

# Set to "false" to forbid keyless IP lookups (forces a provider key or offline-only).
HAMSA_ALLOW_FREE_PROVIDERS=true

# ── Docker Compose only ──────────────────────────────────────────────────────
# Password for the bundled postgres service (URL-safe characters only).
POSTGRES_PASSWORD=change-me-too
